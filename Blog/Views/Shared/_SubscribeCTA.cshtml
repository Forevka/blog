@using Blog.Helper
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

<section class="max-w-4xl mx-auto">
    <div class="glass rounded-[3rem] p-12 md:p-20 text-center relative overflow-hidden border-indigo-500/20">
        <div class="absolute -top-24 -left-24 w-64 h-64 bg-indigo-500/10 rounded-full blur-[80px]"></div>
        <div class="absolute -bottom-24 -right-24 w-64 h-64 bg-purple-500/10 rounded-full blur-[80px]"></div>

        <h2 class="text-4xl md:text-5xl font-black mb-4">Stay in the loop.</h2>
        <p class="text-slate-400 mb-10 max-w-sm mx-auto font-light">Get high-fidelity technical write-ups and code goodies delivered directly to your editor.</p>

        <form id="subscribeForm" method="post" action="@Url.Action("Subscribe", "Home")" class="relative max-w-lg mx-auto flex flex-col md:flex-row gap-2">
            <input type="email" name="Email" maxlength="256" required placeholder="dev@@company.io" class="flex-grow bg-white/5 border border-white/10 rounded-2xl px-6 py-4 text-white focus:outline-none focus:border-indigo-500 transition-colors">
            <button type="submit" class="bg-[#ffab91] text-black font-bold px-8 py-4 rounded-2xl hover:bg-[#ff8a65] transition-all flex items-center justify-center gap-2">
                Subscribe @Icons.Render("zap", "w-4 h-4 fill-black")
            </button>
        </form>
        <p class="mt-6 text-xs text-slate-600 font-mono italic">Pssst... want some goodies?</p>
    </div>
</section>
