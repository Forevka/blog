@using Blog.Helper
@using Umbraco.Cms.Web.Common
@inject UmbracoHelper helper
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var home = Model.AncestorOrSelf<Home>()!;

    var contactsPage = Umbraco.GetPageByAlias("contacts");
    var aboutPage = Umbraco.GetPageByAlias("about");
    var archivePage = Umbraco.GetPageByAlias("articlesMain");
    var pageName = Umbraco.AssignedContentItem;

    var isAbout = pageName.ContentType.Alias == "about";
    var isContacts = pageName.ContentType.Alias == "contacts";
    var isArchive = pageName.ContentType.Alias == "articlesMain";
}

<nav id="site-nav" class="fixed top-0 w-full z-50 px-6 py-4 transition-opacity duration-300">
    <div class="max-w-6xl mx-auto flex justify-between items-center glass rounded-full px-6 py-3">
        <a href="@home.Url()" aria-label="Logo" class="text-xl font-extrabold tracking-tighter flex items-center gap-2">
            <div class="w-8 h-8 accent-gradient rounded-lg flex items-center justify-center">
                @Icons.Render("terminal", "w-5 h-5 text-white")
            </div>
            <span>@home.HeaderText</span>
        </a>
        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-400">
            @if (archivePage != null)
            {
                <a href="@archivePage.Url()" class="hover:text-white transition-colors @(isArchive ? "border-b border-indigo-500 text-white" : "")">Archive</a>
            }
            <a href="@aboutPage!.Url()" class="hover:text-white transition-colors @(isAbout ? "border-b border-indigo-500 text-white" : "")">About</a>
            <a href="@contactsPage!.Url()" class="px-5 py-2 glass rounded-full hover:bg-white hover:text-black transition-all @(isContacts ? "text-white" : "")">Contact</a>
        </div>
        <button id="nav-toggle" class="md:hidden" aria-label="menu" aria-expanded="false">
            <span id="nav-icon-open">@Icons.Render("menu", "w-6 h-6")</span>
            <span id="nav-icon-close" class="hidden">@Icons.Render("x", "w-6 h-6")</span>
        </button>
    </div>
    <div id="nav-mobile" class="hidden md:hidden max-w-6xl mx-auto mt-2 glass rounded-2xl p-6 flex-col gap-4 text-sm font-medium text-slate-300">
        @if (archivePage != null)
        {
            <a href="@archivePage.Url()" class="py-2 hover:text-white transition-colors @(isArchive ? "text-indigo-400" : "")">Archive</a>
        }
        <a href="@aboutPage!.Url()" class="py-2 hover:text-white transition-colors @(isAbout ? "text-indigo-400" : "")">About</a>
        <a href="@contactsPage!.Url()" class="py-2 hover:text-white transition-colors @(isContacts ? "text-indigo-400" : "")">Contact</a>
    </div>
</nav>
