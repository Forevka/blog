@using Blog.Helper
@model List<ITocEntry>

<!-- Floating TOC trigger (Popover API; shown by site.js when interpolate-size is supported) -->
<button class="toc-trigger" popovertarget="toc-popover" popovertargetaction="toggle">
    <div class="toc-trigger-details">
        @Icons.Render("list", "")
        <span>
            <span>Index</span>
            @Icons.Render("chevrons-up-down", "")
        </span>
        <span class="toc-progress"></span>
    </div>
</button>

<!-- Popover Contents -->
<div popover="auto" id="toc-popover">
    <div class="toc-contents">
        <button popovertarget="toc-popover" popovertargetaction="hide">
            <div class="toc-trigger-details">
                @Icons.Render("list", "")
                <span>
                    <span>Index</span>
                    @Icons.Render("chevrons-up-down", "")
                </span>
                <span class="toc-progress"></span>
            </div>
        </button>
        <ol class="toc-list">
            @foreach (var tocEntry in Model)
            {
                <li><a href="#@tocEntry.TocAnchor">@tocEntry.TocText</a></li>
            }
        </ol>
    </div>
</div>

<script type="module">
    const popover = document.getElementById('toc-popover');

    // Close the popover when a TOC link is clicked
    popover.querySelectorAll('ol a').forEach(link => {
        link.addEventListener('click', () => popover.hidePopover());
    });

    // Backfill the popover width/height transition for browsers without "interpolate-size" support
    if (!CSS.supports('interpolate-size: allow-keywords')) {
        let set = false;
        popover.style.setProperty('transition', 'none');
        popover.addEventListener('toggle', () => {
            if (!set) {
                const { height, width } = popover.getBoundingClientRect();
                document.documentElement.style.setProperty('--toc-content-height', `${height}px`);
                document.documentElement.style.setProperty('--toc-content-width', `${width}px`);
                set = true;
                popover.hidePopover();
                requestAnimationFrame(() => {
                    popover.showPopover();
                    popover.style.removeProperty('transition');
                });
            }
        });
    }
</script>
