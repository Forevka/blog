@using System.Globalization
@using Blog.Helper
@using Umbraco.Cms.Core.Models.Blocks
@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits UmbracoViewPage<ArticlesItem>
@{
    Layout = "master.cshtml";

    ViewData["Title"] = Model.Title;

    var tocItems = Model.Content!
        .Where(x => x.Settings is ITocEntry { IsEnabled: true })
        .Select(x => x.Settings as ITocEntry)
        .ToList();

    var categories = (Model.Category ?? []).OfType<ArticleCategory>().Select(x => x.ArticleCategoryName).ToList();
}

@section metatags
{
    <meta content="@Model.CardImage?.Url(mode:UrlMode.Absolute)" property="twitter:image">
    <meta content="@Model.Description" property="twitter:description">
    <meta content="@Model.Title" property="twitter:title">

    <meta content="@Model.CardImage?.Url()" property="og:image">
    <meta content="@Model.Description" property="og:description">
    <meta content="@Model.Title" property="og:title">

    <meta content="@Model.Description" name="description">
}

@if (tocItems.Count > 0)
{
    @await Html.PartialAsync("TOC", tocItems)
}

<!-- Article Header -->
<header class="max-w-3xl mx-auto mb-16">
    <div class="flex flex-wrap items-center gap-3 mb-8">
        @foreach (var category in categories)
        {
            <span class="px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold tracking-widest uppercase">@category</span>
        }
        <span class="text-slate-500 text-xs font-mono">• @Model.ReadTime Min Read</span>
    </div>

    <h1 class="text-4xl md:text-6xl font-extrabold mb-8 tracking-tight leading-[1.1] text-gradient">
        @Model.Title
    </h1>

    <div class="flex items-center justify-between py-8 border-y border-white/5">
        <div class="flex items-center gap-4">
            <div class="w-12 h-12 rounded-full border border-white/10 accent-gradient flex items-center justify-center text-white font-extrabold text-lg" aria-hidden="true">B</div>
            <div>
                <div class="text-sm font-bold text-white">BohdanL</div>
                <div class="text-xs text-slate-500 font-mono italic">Software Engineer</div>
            </div>
        </div>
        <div class="flex gap-2">
            <span class="text-xs text-slate-400">@Model.CreateDate.ToString("MMM dd, yyyy", CultureInfo.InvariantCulture)</span>
        </div>
    </div>
</header>

<!-- Featured Image -->
<div class="max-w-5xl mx-auto mb-16">
    <div class="relative aspect-[21/9] rounded-3xl overflow-hidden border border-white/10">
        <img src="@Model.HeroImage!.Url()" alt="@Model.Title" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
    </div>
</div>

<!-- Content -->
<article class="max-w-3xl mx-auto">

    @if (tocItems.Count > 0)
    {
        <!-- Static TOC fallback (shown when the floating popover isn't supported) -->
        <div id="light-toc" class="glass rounded-2xl p-6 mb-12">
            <div id="toc_list" class="flex items-center justify-between cursor-pointer font-mono text-xs font-bold tracking-widest uppercase text-slate-400"
                 onclick="var t = document.getElementById('toc'); t.style.display = t.style.display === 'none' ? 'block' : 'none';" role="button" tabindex="0">
                <span class="flex items-center gap-2">@Icons.Render("list", "w-4 h-4 text-indigo-400") Table of Contents</span>
                @Icons.Render("chevrons-up-down", "w-4 h-4")
            </div>
            <div id="toc" class="mt-4">
                <ol class="toc-list grid gap-1">
                    @foreach (var tocEntry in tocItems)
                    {
                        <li>
                            <a href="#@tocEntry!.TocAnchor" class="text-slate-400 hover:text-white transition-colors inline-block py-1">@tocEntry.TocText</a>
                        </li>
                    }
                </ol>
            </div>
        </div>
    }

    <div class="article-body rich-text">
        <p class="text-xl text-slate-200">@Model.Description</p>

        <h2>@Model.BodyTitle</h2>
        <p>@Model.BodyDescription</p>

        @{
            foreach (var item in Model.Content!)
            {
                var content = item.Content;
                var alias = content.ContentType.Alias;
                var partialName = char.ToUpper(alias[0]) + alias.Substring(1);

                @await Html.PartialAsync("/Views/Shared/ArticleComponents/" + partialName + ".cshtml", item)

                if (item is BlockGridItem<CodeBlockContent, CodeBlockContentSettings>)
                {
                    if (!Context.Items.TryGetValue("CodeHighlightInitialized", out var _))
                    {
                        @section HeadContent {
                            <script src="https://unpkg.com/@@highlightjs/cdn-assets@11.9.0/highlight.min.js"></script>
                            <script src="https://unpkg.com/@@highlightjs/cdn-assets@11.9.0/languages/csharp.min.js"></script>
                            <script src="https://unpkg.com/@@highlightjs/cdn-assets@11.9.0/languages/clojure.min.js"></script>
                            <script src="https://cdn.jsdelivr.net/npm/highlightjs-line-numbers.js/dist/highlightjs-line-numbers.min.js"></script>
                        }

                        @section Scripts {
                            <script>hljs.highlightAll();</script>
                            <script>hljs.initLineNumbersOnLoad();</script>
                        }

                        Context.Items["CodeHighlightInitialized"] = true;
                    }
                }
            }
        }
    </div>

    <!-- Tags -->
    @if (categories.Count > 0)
    {
        <div class="mt-20 pt-10 border-t border-white/10 flex flex-wrap items-center gap-3">
            <span class="text-xs font-mono text-slate-500 uppercase tracking-widest">Tags:</span>
            @foreach (var category in categories)
            {
                <span class="px-3 py-1 bg-white/5 rounded-md text-xs hover:bg-white/10 transition-colors">#@category!.Replace(" ", "").ToLowerInvariant()</span>
            }
        </div>
    }
</article>

<!-- Author Bio Section -->
<section class="max-w-3xl mx-auto mt-20">
    <div class="glass p-8 rounded-3xl flex flex-col md:flex-row items-center gap-8 border-indigo-500/20">
        <div class="w-24 h-24 rounded-2xl accent-gradient flex items-center justify-center text-white font-extrabold text-4xl shrink-0" aria-hidden="true">B</div>
        <div class="text-center md:text-left">
            <h3 class="text-xl font-bold text-white mb-2">Written by BohdanL</h3>
            <p class="text-slate-400 text-sm leading-relaxed mb-4">
                Writing code with a bit of philosophy. Passionate about .NET, distributed systems, and clean architecture. When not diving into IL code, I'm usually exploring the Carpathian mountains or contributing to open source.
            </p>
            <div class="flex justify-center md:justify-start gap-4">
                <a href="https://github.com/Forevka" target="_blank" rel="noopener" class="flex items-center gap-2 text-indigo-400 text-xs font-bold hover:text-indigo-300 transition-colors">
                    @Icons.Render("github", "w-4 h-4") Follow on GitHub
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Comments -->
<section class="max-w-3xl mx-auto mt-20">
    <script src="https://giscus.app/client.js"
            data-repo="Forevka/blog"
            data-repo-id="R_kgDON3w66g"
            data-category="Comments"
            data-category-id="DIC_kwDON3w66s4CoYd3"
            data-mapping="og:title"
            data-strict="0"
            data-reactions-enabled="1"
            data-emit-metadata="0"
            data-input-position="top"
            data-theme="transparent_dark"
            data-lang="en"
            crossorigin="anonymous"
            async>
    </script>
</section>

@if (Model.RelatedArticles != null && Model.RelatedArticles.Any())
{
    <!-- Related Posts Section -->
    <section class="max-w-6xl mx-auto mt-32">
        <h2 class="text-3xl font-bold mb-12">Read also</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            @{
                var relatedIndex = 0;
            }
            @foreach (var related in Model.RelatedArticles.OfType<ArticlesItem>())
            {
                ViewData["CardIndex"] = relatedIndex++;
                @await Html.PartialAsync("_BlogPostItem", related, ViewData)
            }
        </div>
    </section>
}
